{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Deploy Backend",
      "type": "shell",
      "command": "cd server && git add . && git commit -m 'backend deploy' && git push",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Deploy Frontend",
      "type": "shell",
      "command": "cd client && git add . && git commit -m 'frontend deploy' && git push",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Deploy Both",
      "type": "shell",
      "command": "cd server && git add . && git commit -m 'backend deploy' && git push && cd ../client && git add . && git commit -m 'frontend deploy' && git push",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    }
  ]
}
